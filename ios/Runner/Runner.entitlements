<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<!-- Debug builds. Must match Runner-Release.entitlements so a
		     Universal Link behaves the same in both. To test against a local
		     tunnel, change this line locally and do NOT commit it — a
		     tunnel host committed here previously shipped in debug and its
		     Android counterpart shipped in release. -->
		<string>applinks:wowcare-uat.childcarewow.app</string>
		<!-- PROD web domain — was missing entirely, so no iOS build (debug
		     or release) ever recognized Universal Links from
		     wowcare.childcarewow.app, regardless of which --dart-define
		     ENVIRONMENT it was built with. Android's equivalent
		     (build.gradle.kts appLinkHost) already switched hosts per
		     environment; iOS never did — this listed both entries so ONE
		     binary handles either domain instead of trying to replicate
		     Android's per-build switch (Xcode entitlements aren't
		     parameterized by dart-define here). -->
		<string>applinks:wowcare.childcarewow.app</string>
	</array>
</dict>
</plist>
