# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # ---------------------------------------------------------------------
    # "Always" (background) location is NOT used by this app. App Review
    # rejected it under guideline 2.5.4, so Info.plist deliberately omits
    # NSLocationAlwaysAndWhenInUseUsageDescription.
    #
    # App Store upload validation (ITMS-90683) scans the *compiled binary* for
    # the requestAlwaysAuthorization selector and demands the matching purpose
    # string whenever it is linked in — it does not care whether the app ever
    # calls it. Both location pods compile that selector by default, so the
    # flags below strip it out instead of re-adding the plist key:
    #
    #   BYPASS_PERMISSION_LOCATION_ALWAYS=1
    #     geolocator_apple — removes its requestAlwaysAuthorization branch.
    #     That branch was already unreachable at runtime (it is an `else if`
    #     after the NSLocationWhenInUseUsageDescription check, and we ship that
    #     key), so this is behaviourally inert.
    #
    #   PERMISSION_LOCATION  (deliberately NOT set)
    #     permission_handler_apple compiles its whole LocationPermissionStrategy
    #     — requestAlwaysAuthorization included — behind this guard. It used to
    #     be forced to 1 because Permission.location.status silently returned
    #     denied without it, breaking iOS GPS attendance. That is no longer
    #     needed: GeofencingLocalDataSource now routes *all* iOS location
    #     permission checks and requests through Geolocator (see
    #     lib/data/features/geofencing/datasources/geofencing_local_datasource.dart);
    #     on iOS permission_handler is only used for camera and notifications.
    #     Leaving it unset keeps the Always selector out of the binary.
    #
    # Do NOT re-add either flag/key without a user-facing feature Apple accepts
    # as needing background location.
    #
    # PERMISSION_CAMERA=1 / PERMISSION_NOTIFICATIONS=1
    #     permission_handler_apple compiles every permission out by default; a
    #     permission without its flag reports "denied" on check and
    #     "permanently denied" on request, with no dialog. These two back
    #     AppPermission.camera / .notifications in lib/core/utils/permission_manager.dart.
    #     Adding an AppPermission that uses permission_handler on iOS means
    #     adding its flag here (and its Info.plist usage string).
    # ---------------------------------------------------------------------
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'BYPASS_PERMISSION_LOCATION_ALWAYS=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_CAMERA=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_NOTIFICATIONS=1'

      # Newer Xcode versions only support deployment targets 15.0+ and fail
      # the build ("Target Integrity … IPHONEOS_DEPLOYMENT_TARGET is set to 9.0")
      # for any pod still declaring an older one. Raise those to the app's
      # minimum (platform :ios above); never lower a pod that asks for more.
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_s
      if current.empty? || Gem::Version.new(current) < Gem::Version.new('15.0')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end

  # ---------------------------------------------------------------------------
  # Firebase multi-environment: inject a Run Script Build Phase into Runner that
  # decodes $DART_DEFINES, extracts ENVIRONMENT, and copies the matching
  # GoogleService-Info.plist into the built app bundle.
  # Runs once on every `pod install`; skips if the phase already exists.
  # ---------------------------------------------------------------------------
  require 'xcodeproj'
  runner_project_path = File.expand_path('../Runner.xcodeproj', __FILE__)
  runner_project = Xcodeproj::Project.open(runner_project_path)
  runner_target  = runner_project.targets.find { |t| t.name == 'Runner' }

  if runner_target
    phase_name = 'Copy Firebase GoogleService-Info.plist'
    already_added = runner_target.build_phases.any? do |p|
      p.respond_to?(:name) && p.name == phase_name
    end

    unless already_added
      phase = runner_target.new_shell_script_build_phase(phase_name)
      phase.shell_script = '"${SRCROOT}/scripts/copy_firebase_config.sh"'
      # Input/output paths let Xcode skip the phase when nothing has changed.
      phase.input_paths  = ['$(SRCROOT)/scripts/copy_firebase_config.sh']
      phase.output_paths = ['$(BUILT_PRODUCTS_DIR)/$(PRODUCT_NAME).app/GoogleService-Info.plist']
      runner_project.save
      puts "✅ [Firebase] Added '#{phase_name}' build phase to Runner"
    end

    phase_name_crashlytics = 'Firebase Crashlytics dSYM Upload'
    already_added_crashlytics = runner_target.build_phases.any? do |p|
      p.respond_to?(:name) && p.name == phase_name_crashlytics
    end

    unless already_added_crashlytics
      phase_crash = runner_target.new_shell_script_build_phase(phase_name_crashlytics)
      phase_crash.shell_script = '"${PODS_ROOT}/FirebaseCrashlytics/run"'
      phase_crash.input_paths  = [
        '${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${TARGET_NAME}',
        '$(SRCROOT)/$(BUILT_PRODUCTS_DIR)/$(INFOPLIST_PATH)'
      ]
      runner_project.save
      puts "✅ [Firebase] Added '#{phase_name_crashlytics}' build phase to Runner"
    end
  end
end
