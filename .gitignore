# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Generated desktop scaffolding. This app ships Android and iOS only, and
# neither directory holds a runner project, so neither one can build. Every
# file in them is regenerated by `flutter pub get`, and the ephemeral ones
# record absolute paths from whoever ran the last build, so they come back
# modified on every machine that touches the repo.
/linux/
/macos/
/windows/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Apple APNs auth keys — secret, never commit
*.p8
AuthKey_*.p8

# Sentry DSN for local builds (read by the Makefile). Never commit.
sentry.local.json
