<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. We exclude the app's private storage from
  BOTH cloud backup and device-to-device transfer so that an uninstall always
  yields a fresh app (no restored auth token / onboarding flag). Combined with
  android:allowBackup="false" + android:fullBackupContent="false" this disables
  restore across all Android versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
